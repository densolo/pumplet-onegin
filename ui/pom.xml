<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.dc8.pumplet.onegin</groupId>
        <artifactId>pumplet-onegin-parent</artifactId>
        <version>1.1-SNAPSHOT</version>
    </parent>

    <!--
      Desktop UI (Compose for Desktop) on top of the CLI and core. Runs as a plain Java app:
        mvn -pl ui -am package && java -jar ui/target/pumplet-onegin-ui.jar
      or run app.dc8.pumplet.onegin.ui.MainKt from the IDE.
      The skiko runtime below is for macOS on Apple Silicon; use the -macos-x64, -linux-x64 or
      -windows-x64 artifact on other machines (-Dskiko.platform=...).
    -->
    <artifactId>pumplet-onegin-ui</artifactId>

    <properties>
        <compose.version>1.12.2</compose.version>
        <skiko.version>0.150.2</skiko.version>
        <skiko.platform>macos-arm64</skiko.platform>
        <androidx.compose.version>1.12.1</androidx.compose.version>
        <!--
          The Compose compiler plugin jar for -Xplugin: a fixed path inside the project, where
          maven-dependency-plugin:copy (below) puts it, so it doesn't depend on where a machine keeps its
          local repository. Maven's kotlinc is the embeddable compiler and needs the embeddable plugin;
          IntelliJ's build uses the regular compiler and gets the regular plugin through the
          "intellij" profile below. (Same setup as mac-one-copy.)
        -->
        <compose.compiler.plugin.jar>${project.build.directory}/compose-compiler/kotlin-compose-compiler-plugin-embeddable.jar</compose.compiler.plugin.jar>
    </properties>

    <repositories>
        <!-- Compose for Desktop depends on AndroidX libraries, which are published here. -->
        <repository>
            <id>google</id>
            <url>https://maven.google.com/</url>
        </repository>
    </repositories>

    <!--
      AndroidX artifacts pin exact versions ([1.12.1,1.12.1] vs [1.11.0,1.11.0]); Gradle aligns them,
      Maven needs them pinned to the version Compose ${compose.version} is built on.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>androidx.compose.runtime</groupId>
                <artifactId>runtime-desktop</artifactId>
                <version>${androidx.compose.version}</version>
            </dependency>
            <dependency>
                <groupId>androidx.compose.runtime</groupId>
                <artifactId>runtime-saveable-desktop</artifactId>
                <version>${androidx.compose.version}</version>
            </dependency>
            <dependency>
                <groupId>androidx.compose.runtime</groupId>
                <artifactId>runtime-retain-desktop</artifactId>
                <version>${androidx.compose.version}</version>
            </dependency>
            <dependency>
                <groupId>androidx.compose.runtime</groupId>
                <artifactId>runtime-annotation-jvm</artifactId>
                <version>${androidx.compose.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>app.dc8.pumplet.onegin</groupId>
            <artifactId>pumplet-onegin-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-swing</artifactId>
            <version>${coroutines.version}</version>
        </dependency>
        <!-- Compose for Desktop: Maven needs the -desktop (JVM) artifacts named directly. -->
        <dependency>
            <groupId>org.jetbrains.compose.runtime</groupId>
            <artifactId>runtime-desktop</artifactId>
            <version>${compose.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.compose.ui</groupId>
            <artifactId>ui-desktop</artifactId>
            <version>${compose.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.compose.foundation</groupId>
            <artifactId>foundation-desktop</artifactId>
            <version>${compose.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.compose.material</groupId>
            <artifactId>material-desktop</artifactId>
            <version>${compose.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>skiko-awt-runtime-${skiko.platform}</artifactId>
            <version>${skiko.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>pumplet-onegin-ui</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>app.dc8.pumplet.onegin.ui.MainKt</mainClass>
                                    <manifestEntries>
                                        <!-- Skia (skiko) and Mordant load native code; allow it without JDK warnings. -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>app.dc8.pumplet.onegin.ui.MainKt</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <!-- Copies both builds of the Compose compiler plugin to target/compose-compiler (see compose.compiler.plugin.jar). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>compose-compiler</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.jetbrains.kotlin</groupId>
                                    <artifactId>kotlin-compose-compiler-plugin-embeddable</artifactId>
                                    <version>${kotlin.version}</version>
                                    <destFileName>kotlin-compose-compiler-plugin-embeddable.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.jetbrains.kotlin</groupId>
                                    <artifactId>kotlin-compose-compiler-plugin</artifactId>
                                    <version>${kotlin.version}</version>
                                    <destFileName>kotlin-compose-compiler-plugin.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/compose-compiler</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xplugin=${compose.compiler.plugin.jar}</arg>
                    </args>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
              Active only while IntelliJ IDEA imports the project (it sets idea.maven.embedder.version).
              IntelliJ compiles with the plain Kotlin compiler, which needs the plain Compose plugin, and
              doesn't run maven-dependency-plugin, so the path is spelled out. It assumes the default
              local repository (~/.m2/repository); IntelliJ resolves ${user.home} but not
              ${settings.localRepository}. With another local repository, change it here.
            -->
            <id>intellij</id>
            <activation>
                <property>
                    <name>idea.maven.embedder.version</name>
                </property>
            </activation>
            <properties>
                <compose.compiler.plugin.jar>${user.home}/.m2/repository/org/jetbrains/kotlin/kotlin-compose-compiler-plugin/${kotlin.version}/kotlin-compose-compiler-plugin-${kotlin.version}.jar</compose.compiler.plugin.jar>
            </properties>
        </profile>
    </profiles>
</project>
